# --- Supabase (optional in development) ---
# Without these, the app uses a local JSON file store in .data/ and a dev-only sign-in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Content generation (feature/generation) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Owner alerts when generation falls back to the backup bank ---
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# --- Protects /api/cron/* routes ---
CRON_SECRET=

# Public site URL, used in share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

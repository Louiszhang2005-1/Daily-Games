# --- Supabase (optional in development) ---
# Without these, the app uses a local JSON file store in .data/ and a dev-only sign-in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Content generation (feature/generation) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Owner alerts when generation falls back to the backup bank ---
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# --- Protects /api/cron/* routes ---
CRON_SECRET=

# Public site URL, used in share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep the dev-only sign-in in a production build without Supabase (testing only)
ALLOW_DEV_LOGIN=

# Extra comma-separated words for the content blocklist
BLOCKLIST_EXTRA=

# Sign-in buttons to show (enable the same providers in Supabase): google, apple, azure (Microsoft)
NEXT_PUBLIC_AUTH_PROVIDERS=google,apple,azure
